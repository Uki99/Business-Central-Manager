<Window x:Class="BE_terna_Business_Central_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="clr-namespace:BE_terna_Business_Central_Manager"
        mc:Ignorable="d"
        Title="Business Central Manager" 
        Height="600" 
        Width="1050"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="Transparent" CornerRadius="4,4,0,0" Margin="3,4,3,0" Padding="16,0">
                            <Grid>
                                <ContentPresenter x:Name="TabHeader" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="#CEDAF2" TextElement.FontWeight="SemiBold"/>
                                <Border x:Name="TabAccent" Height="3" Background="Orange" VerticalAlignment="Bottom" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#294181"/>
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="White"/>
                                <Setter TargetName="TabAccent" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabSurface" Property="Background" Value="#1C2B6A"/>
                                <Setter TargetName="TabHeader" Property="TextElement.Foreground" Value="White"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="48" Height="26">
                            <Border x:Name="Track" CornerRadius="13" BorderBrush="#879DC6" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush x:Name="TrackFill" Color="#34476D"/>
                                </Border.Background>
                            </Border>
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="White"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThumbOffset"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="TrackFill" Storyboard.TargetProperty="Color" To="#159F80" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbOffset" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ColorAnimation Storyboard.TargetName="TrackFill" Storyboard.TargetProperty="Color" To="#34476D" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="Orange"/>
                                <Setter TargetName="Track" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsInput" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="#182D5A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#879DC6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="Orange"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Body 2x2 -->
    <Grid Background="Navy">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- App title -->
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="BC Manager"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="20,0,0,0"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="White"/>


        <!-- Topics Container -->
        <StackPanel x:Name="TopicsContainer"
                    Grid.Row="1" 
                    Grid.Column="0"
                    Grid.RowSpan="2">

            <!-- App Management topic -->
            <RadioButton x:Name="AppManagementTopic"
                         Tag="AppManagementTabs"
                         Content="App Management"
                         Height="50"
                         FontSize="14"
                         Foreground="White"
                         IsChecked="true">

                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" BorderBrush="CornflowerBlue" BorderThickness="3" Visibility="Collapsed" />
                            <Border Grid.ColumnSpan="2" Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <!-- License Management topic -->
            <RadioButton x:Name="ServerManagementTopic"
                         Tag="ServerManagementTabs"
                         Content="Server Management"
                         Height="50"
                         FontSize="14"
                         Foreground="White">

                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" BorderBrush="CornflowerBlue" BorderThickness="3" Visibility="Collapsed" />
                            <Border Grid.ColumnSpan="2" Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <!-- Container Management topic -->
            <RadioButton x:Name="ContainerManagementTopic"
                         Tag="ContainerManagementTabs"
                         Content="Container Management"
                         Height="50"
                         FontSize="14"
                         Foreground="White">

                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" BorderBrush="CornflowerBlue" BorderThickness="3" Visibility="Collapsed" />
                            <Border Grid.ColumnSpan="2" Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <!-- Settings topic -->
            <RadioButton x:Name="SettingsTopic"
                         Tag="SettingsTabs"
                         Content="Settings"
                         Height="50"
                         FontSize="14"
                         Foreground="White">

                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" BorderBrush="CornflowerBlue" BorderThickness="3" Visibility="Collapsed" />
                            <Border Grid.ColumnSpan="2" Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>

            <!-- About topic -->
            <RadioButton x:Name="AboutTopic"
                         Tag="AboutContent"
                         Content="About"
                         Height="50"
                         FontSize="14"
                         Foreground="White">

                <RadioButton.Template>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="border" BorderBrush="CornflowerBlue" BorderThickness="3" Visibility="Collapsed" />
                            <Border Grid.ColumnSpan="2" Background="Transparent">
                                <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </RadioButton.Template>
            </RadioButton>
        </StackPanel>

        <!-- Splitter -->
        <Rectangle Grid.Column="1" 
                   Grid.Row="1" 
                   Width="2" 
                   VerticalAlignment="Stretch"
                   Margin="0,15,0,15"
                   Fill="White" 
                   HorizontalAlignment="Left"/>

        <!-- Topics Tab Container -->
        <Grid x:Name="TopicsTabContainer"
              Grid.Row="0"
              Grid.Column="1"
              Grid.RowSpan="2">

            <!-- App Management tab control -->
            <TabControl x:Name="AppManagementTabs" 
                        Background="Navy"
                        BorderThickness="0"
                        Margin="10,0,0,0">

                <!-- App Publishing tab -->
                <TabItem Header="App Publishing" 
                         Background="Navy" 
                         Foreground="White" 
                         Height="50"
                         FontSize="14">

                    <Grid Margin="15,30,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Settings -->
                        <Grid Grid.Row="0" Margin="0,0,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Server Instance" VerticalAlignment="Center" Foreground="White" Width="120"/>

                                <ComboBox Width="210" Height="28" x:Name="AppPublishingServerInstanceComboBox">
                                    <ComboBox.Items></ComboBox.Items>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Sync Mode" VerticalAlignment="Center" Foreground="White" Width="120"/>

                                <ComboBox Width="210" SelectedIndex="0" Height="28" x:Name="AppPublishingSyncModeComboBox">
                                    <ComboBox.Items>
                                        <ComboBoxItem>Add (default)</ComboBoxItem>
                                        <ComboBoxItem>Development</ComboBoxItem>
                                        <ComboBoxItem>ForceSync</ComboBoxItem>
                                    </ComboBox.Items>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <Label Content="Choose App" VerticalAlignment="Center" Foreground="White" Width="120"/>

                                <Button VerticalAlignment="Center" 
                                        Foreground="Black"
                                        Width="210"
                                        Height="28"
                                        Content="Choose"
                                        Background="LightGray"
                                        x:Name="AppPublishingChooseAppBtn">
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Label Content="Upload App" VerticalAlignment="Center" Foreground="White" Width="120"/>

                                <Button VerticalAlignment="Center" 
                                        Foreground="Black"
                                        Width="210"
                                        Height="28"
                                        Content="Send"
                                        Background="LightGray" 
                                        FontWeight="Bold"
                                        x:Name="AppPublishingSendAppBtn">
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- App Info -->
                        <Grid Grid.Row="1" Margin="0,30,20,0">
                            <Grid.Resources>
                                <Style TargetType="DockPanel" x:Key="DockPanelStyle">
                                    <Setter Property="TextElement.FontSize" Value="12"/>
                                </Style>
                            </Grid.Resources>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,10" Style="{StaticResource DockPanelStyle}">
                                <Label Content="Name" VerticalAlignment="Center" Foreground="White" Width="60"/>

                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                    <TextBlock VerticalAlignment="Center" x:Name="AppPublishingAppNameTxt"></TextBlock>
                                </Border>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0" Style="{StaticResource DockPanelStyle}">
                                <Label Content="App ID" VerticalAlignment="Center" Foreground="White" Width="60" />

                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                    <TextBlock VerticalAlignment="Center" x:Name="AppPublishingAppIdTxt"></TextBlock>
                                </Border>
                            </DockPanel>

                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Style="{StaticResource DockPanelStyle}">
                                <Label Content="Version" VerticalAlignment="Center" Foreground="White" Width="70"/>

                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                    <TextBlock VerticalAlignment="Center" x:Name="AppPublishingAppVersionTxt"></TextBlock>
                                </Border>
                            </DockPanel>

                            <DockPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource DockPanelStyle}">
                                <Label Content="Publisher" VerticalAlignment="Center" Foreground="White" Width="70"/>

                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                    <TextBlock VerticalAlignment="Center" x:Name="AppPublishingAppPublisherTxt"></TextBlock>
                                </Border>
                            </DockPanel>

                            <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,20,0,0" Style="{StaticResource DockPanelStyle}">
                                <Label Content="Path" VerticalAlignment="Center" Foreground="White" Width="60"/>

                                <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                    <TextBlock VerticalAlignment="Center" x:Name="AppPublishingAppPathTxt" TextWrapping="Wrap"></TextBlock>
                                </Border>
                            </DockPanel>

                            <!-- Progress Bar -->
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,30" x:Name="AppPublishingProgress" Visibility="Hidden" IsEnabled="False">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10" x:Name="AppPublishingProgressInfoTxt">Working on it...</TextBlock>
                                <ProgressBar Width="600" Height="20" x:Name="AppPublishingProgressBar" Value="0" Foreground="Orange"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Multiple App Publishing tab -->
                <TabItem
                Header="Multiple App Publishing"
                Background="Navy" 
                Foreground="White" 
                Height="50"
                FontSize="14">

                    <Grid Margin="15,30,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!-- Settings -->
                        <Grid Grid.Row="0" Margin="0,0,20,0">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Server Instance" VerticalAlignment="Center" Foreground="White" Width="140"/>

                                <ComboBox Width="210" Height="28" x:Name="MultipleAppPublishingServerInstanceComboBox">
                                    <ComboBox.Items></ComboBox.Items>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Label Content="Sync Mode" VerticalAlignment="Center" Foreground="White" Width="120"/>

                                <ComboBox Width="210" SelectedIndex="0" Height="28" x:Name="MultipleAppPublishingSyncModeComboBox">
                                    <ComboBox.Items>
                                        <ComboBoxItem>Add (default)</ComboBoxItem>
                                        <ComboBoxItem>Development</ComboBoxItem>
                                        <ComboBoxItem>ForceSync</ComboBoxItem>
                                    </ComboBox.Items>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal">
                                <Label Content="Choose App Folder" VerticalAlignment="Center" Foreground="White" Width="140"/>

                                <Button VerticalAlignment="Center" 
                                        Foreground="Black"
                                        Width="210"
                                        Height="28"
                                        Content="Choose"
                                        Background="LightGray"
                                        x:Name="MultipleAppPublishingChooseAppBtn">
                                </Button>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <Label Content="Upload App" VerticalAlignment="Center" Foreground="White" Width="120"/>

                                <Button VerticalAlignment="Center" 
                                        Foreground="Black"
                                        Width="210"
                                        Height="28"
                                        Content="Send"
                                        Background="LightGray" 
                                        FontWeight="Bold"
                                        x:Name="MultipleAppPublishingSendAppBtn">
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Instalation info section -->
                        <Grid Grid.Row="1" Margin="0,30,20,0">
                            <Grid.Resources>
                                <Style TargetType="DockPanel" x:Key="DockPanelStyle">
                                    <Setter Property="TextElement.FontSize" Value="12"/>
                                </Style>
                            </Grid.Resources>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <DockPanel Style="{StaticResource DockPanelStyle}" Margin="0,0,0,20">
                                    <Label Content="Folder Path" VerticalAlignment="Center" Foreground="White" Width="80" />
                                    <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                        <TextBlock VerticalAlignment="Center" x:Name="MultipleAppPublishingAppPathTxt" TextWrapping="Wrap" />
                                    </Border>
                                </DockPanel>

                                <ScrollViewer Grid.Row="0" MaxHeight="230" VerticalScrollBarVisibility="Auto" FontSize="12">
                                    <ListView x:Name="MultipleAppPublishingAppStatusList">
                                        <ListView.View>
                                            <GridView AllowsColumnReorder="False">
                                                <GridView.ColumnHeaderContainerStyle>
                                                    <Style TargetType="{x:Type GridViewColumnHeader}">
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="2">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </GridView.ColumnHeaderContainerStyle>

                                                <GridViewColumn Header="App Name" Width="500" DisplayMemberBinding="{Binding AppName}" />
                                                <GridViewColumn Header="App Version" Width="200" DisplayMemberBinding="{Binding AppVersion}" />
                                                <GridViewColumn Header="Status" Width="55">
                                                    <GridViewColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Status}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                                        <Setter Property="TextAlignment" Value="Center" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Status}" Value="✔️">
                                                                                <Setter Property="Foreground" Value="Green" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Status}" Value="❌">
                                                                                <Setter Property="Foreground" Value="Red" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </GridViewColumn.CellTemplate>
                                                </GridViewColumn>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                </ScrollViewer>
                            </StackPanel>

                            <!-- Progress Bar -->
                            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,30" x:Name="MultipleAppPublishingProgress" Visibility="Hidden" IsEnabled="False">
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10" x:Name="MultipleAppPublishingProgressInfoTxt">Working on it...</TextBlock>
                                <ProgressBar Width="600" Height="20" x:Name="MultipleAppPublishingProgressBar" Value="0" Foreground="Orange"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Server Management tab control -->
            <TabControl x:Name="ServerManagementTabs" 
                        Background="Navy"
                        BorderThickness="0"
                        Margin="10,0,0,0"
                        Visibility="Hidden" 
                        IsEnabled="False">

                <TabItem Header="License Management" 
                         Background="Navy" 
                         Foreground="White" 
                         Height="50"
                         FontSize="14">

                    <Grid Margin="15,30,20,0">
                        <Grid.Resources>
                            <Style TargetType="DockPanel" x:Key="DockPanelStyle">
                                <Setter Property="TextElement.FontSize" Value="12"/>
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="Server Instance" VerticalAlignment="Center" Foreground="White" Width="120"/>

                            <ComboBox Width="210" Height="28" x:Name="LicenseServerInstanceComboBox">
                                <ComboBox.Items></ComboBox.Items>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                            <Label Content="License" VerticalAlignment="Center" Foreground="White" Width="70"/>

                            <Button VerticalAlignment="Center" 
				                    Foreground="Black"
				                    Width="210"
				                    Height="28"
				                    Content="Choose"
				                    Background="LightGray"
				                    x:Name="LicenseChooseBtn">
                            </Button>
                        </StackPanel>

                        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,20,0,0" Style="{StaticResource DockPanelStyle}">
                            <Label Content="Path" VerticalAlignment="Center" Foreground="White" Width="60"/>

                            <Border BorderBrush="White" BorderThickness="1" CornerRadius="4" Padding="5">
                                <TextBlock VerticalAlignment="Center" x:Name="LicensePathTxt" TextWrapping="Wrap"></TextBlock>
                            </Border>
                        </DockPanel>

                        <StackPanel Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    Margin="0,30,0,0">

                            <Button VerticalAlignment="Center"                                    
                                    Foreground="Black"
                                    Width="400"
                                    Height="40"
                                    Content="Load license &amp; restart instance"
                                    FontWeight="Bold"
                                    Background="LightGray"
                                    x:Name="LoadBcLicenseBtn">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button VerticalAlignment="Center"
                                    Margin="0,10,0,0"
                                    Foreground="Black"
                                    Width="400"
                                    Height="40"
                                    Content="Get current license information"
                                    Background="LightGray"
                                    x:Name="GetCurrentBcLicenseInfoBtn">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>                        
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Container Management tab control -->
            <TabControl x:Name="ContainerManagementTabs" 
                        Background="Navy"
                        BorderThickness="0"
                        Margin="10,0,0,0"
                        Visibility="Hidden"
                        IsEnabled="False">

                <TabItem Header="App Publishing" 
                         Background="Navy" 
                         Foreground="White" 
                         Height="50"
                         FontSize="14">

                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">COMING SOON</TextBlock>
                </TabItem>

                <TabItem Header="Multiple App Publishing" 
                         Background="Navy" 
                         Foreground="White" 
                         Height="50"
                         FontSize="14">

                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">COMING SOON</TextBlock>
                </TabItem>

                <TabItem Header="License Management" 
                         Background="Navy" 
                         Foreground="White" 
                         Height="50"
                         FontSize="14">

                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center">COMING SOON</TextBlock>
                </TabItem>
            </TabControl>

            <!-- Settings tab control -->
            <TabControl x:Name="SettingsTabs" 
                        Background="Navy"
                        BorderThickness="0"
                        Margin="10,0,0,0"
                        Visibility="Hidden"
                        IsEnabled="False">

                <TabItem Header="General" 
                         Background="Navy" 
                         Foreground="White" 
                         Height="50"
                         FontSize="14">

                    <Grid Margin="15,30,20,0">
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Application version" Grid.Row="0" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ApplicationVersion" Grid.Row="0" Grid.Column="1" Margin="10" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="White"/>

                        <TextBlock Text="Hide PowerShell console" Grid.Row="1" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <CheckBox x:Name="HidePowerShellConsole" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Hide PowerShell console"/>

                        <TextBlock Text="NavAdminTool path" Grid.Row="2" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <TextBox x:Name="NavAdminTool" Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsInput}"/>

                        <TextBlock Text="Supported BC version" Grid.Row="3" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <TextBox x:Name="SupportedBusinessCentralVersion" Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingsInput}"/>

                        <TextBlock Text="Tenant ID" Grid.Row="4" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <TextBox x:Name="TenantId" Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingsInput}"/>

                        <TextBlock Text="Unpublish old app after upgrade" Grid.Row="5" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <CheckBox x:Name="UnpublishLastInstalledAppDuringUpgrade" Grid.Row="5" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Unpublish old app after upgrade" ToolTip="Only if no tenant still uses the old version."/>

                        <TextBlock Text="Check BCContainerHelper updates on tab open" Grid.Row="6" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <CheckBox x:Name="SearchForUpdateBcContainerHelper" Grid.Row="6" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Check BCContainerHelper updates on tab open" ToolTip="Checks when opening Container Management and asks before updating."/>

                        <TextBlock Text="Update app at startup" Grid.Row="7" Grid.Column="0" Margin="10" VerticalAlignment="Center"/>
                        <CheckBox x:Name="CheckForApplicationUpdateOnStart" Grid.Row="7" Grid.Column="1" Style="{StaticResource SettingsSwitch}" AutomationProperties.Name="Update app at startup"/>

                        <Button VerticalAlignment="Bottom"
                            Grid.Row="8"
                                Grid.ColumnSpan="2"
                                Margin="0,10,0,30"
                                Foreground="#101D3B"
                                FontWeight="SemiBold"
                                Width="400"
                                Height="40"
                                Content="Save &amp; Restart"
                                Background="Orange"
                                x:Name="SettingsSaveBtn">

                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                    </Grid>
                </TabItem>
            </TabControl>

                <!-- About view -->
                <Grid x:Name="AboutContent"
                        Background="Navy"
                        Margin="10,0,0,0"
                        Visibility="Hidden"
                        IsEnabled="False">

                    <Grid Margin="36,30,36,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,28">
                            <TextBlock Text="Business Central Manager" FontSize="28" FontWeight="SemiBold" Foreground="White" TextAlignment="Center"/>
                            <TextBlock Text="BUSINESS CENTRAL / ON-PREMISES" FontSize="11" FontWeight="SemiBold" Foreground="#ACC2E8" TextAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="185" />
                                <ColumnDefinition Width="185" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="VERSION" FontSize="11" FontWeight="SemiBold" Foreground="#ACC2E8" TextAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="VersionTextBlock" FontSize="15" Foreground="White" TextAlignment="Center">
                                    <Run x:Name="AboutTabDisplayVersionTxt"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="CREATED BY" FontSize="11" FontWeight="SemiBold" Foreground="#ACC2E8" TextAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock x:Name="AuthorTextBlock" Text="Uglješa Ćirić" FontSize="15" Foreground="White" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="2" Height="1" Background="#445B90" Margin="50,28,50,24"/>

                        <TextBlock x:Name="DescriptionTextBlock" Grid.Row="3" FontSize="14" Foreground="#DCE5F5" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="550" HorizontalAlignment="Center">
                            A PowerShell desktop application for managing Business Central on-premises.<LineBreak/><LineBreak/>
                            Find updates and report issues on
                            <Hyperlink x:Name="GitHubLink" Foreground="Orange" NavigateUri="https://github.com/Uki99/Business-Central-Manager">GitHub</Hyperlink>.
                        </TextBlock>

                        <Grid Grid.Row="5" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="CheckForUpdatesBtn" Grid.Column="0" Width="212" Height="40" FontSize="14"
                                    Foreground="#101D3B" FontWeight="SemiBold" Content="Check for Updates" Background="Orange">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="ShowDocumentationBtn" Grid.Column="1" Width="212" Height="40" FontSize="14"
                                    Foreground="White" FontWeight="SemiBold" Content="Show Documentation" Background="#28447F" BorderBrush="#6B86B7" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="CopyrightTextBlock" Grid.Row="6" HorizontalAlignment="Center" Foreground="#B4C3E1" FontSize="11" Margin="0,24,0,0">Copyright 2026 Uglješa Ćirić. All rights reserved.</TextBlock>
                    </Grid>
            </Grid>
        </Grid>
        <Border x:Name="ContainerModuleLoading"
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="1"
                Background="#E8090D31"
                Visibility="Collapsed"
                Panel.ZIndex="10">
            <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading BCContainerHelper..." Foreground="White" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,16"/>
                <Grid x:Name="ContainerLoadingSpinner" Width="30" Height="30" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform/>
                    </Grid.RenderTransform>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="IsVisible" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard Name="LoadingSpinner">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <RemoveStoryboard BeginStoryboardName="LoadingSpinner"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Ellipse Width="26" Height="26" Stroke="#516A9C" StrokeThickness="3"/>
                    <Path Data="M 15,2 A 13,13 0 0 1 28,15" Stroke="Orange" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
